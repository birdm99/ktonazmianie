# === Wdrożenie: skopiuj i ewentualnie edytuj jedną linię (APP_URL) ===
# ./scripts/deploy.sh — tworzy .env automatycznie, jeśli go nie ma.

# Publiczny adres za HTTPS (np. https://grafik.firma.pl). PUSTE = API i UI działają
# na dowolnym hoście/porcie (window.location.origin). Ustaw przed OIDC w produkcji.
APP_URL=

# Gdzie nasłuchuje aplikacja na hoście (NPM zwykle: 127.0.0.1 + WEB_PORT)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Panel PocketBase tylko na localhost (SSH / tunel); nie wystawiaj publicznie
PB_PORT=8091

# Front (bake w obrazie podczas deploy.sh). Produkcja za jednym hostem: zostaw puste.
VITE_PB_URL=

# Przycisk OIDC w UI (provider „oidc” w PocketBase konfigurujesz później)
VITE_OIDC_ENABLED=true

# --- Zgodność wsteczna (opcjonalnie, zamiast APP_URL) ---
# PB_PUBLIC_URL=

# Bezpośredni dostęp z internetu bez reverse proxy (niezalecane w prod):
# WEB_BIND=0.0.0.0